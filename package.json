{
    "name": "lms-ui-remake",
    "version": "2.0.0",
    "description": "Modern LMS portal built with Vite, React, TypeScript, Tailwind CSS, Express, and Neon Postgres",
    "type": "module",
    "main": "dist-server/server/index.js",
    "scripts": {
        "dev": "concurrently -k -n api,worker,web -c cyan,green,magenta \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
        "dev:api": "tsx watch server/index.ts",
        "dev:web": "vite --host 0.0.0.0",
        "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
        "start": "node dist-server/server/index.js",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
        "test:semester": "node --import tsx --test tests/semesterWhitelist.test.mjs",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:seed": "tsx scripts/seed.ts",
        "db:reset": "tsx scripts/seed.ts --reset",
        "scrape": "node scraper.js",
        "scrape:courses": "node scraper-courses.js",
        "scrape:assignments": "node scraper-assignments.js",
        "scrape:lite": "node scraper-lite.js",
        "dev:worker": "tsx watch server/worker.ts",
        "start:worker": "node dist-server/server/worker.js",
        "owner:create": "tsx scripts/owner.ts",
        "config:keys": "tsx scripts/keys.ts",
        "test": "node --import tsx --test tests/*.test.mjs"
    },
    "keywords": [
        "lms",
        "react",
        "vite",
        "tailwindcss",
        "neon",
        "postgresql"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@neon/config": "^1.7.2",
        "@neon/env": "^1.4.3",
        "axios": "^1.20.0",
        "axios-cookiejar-support": "^7.0.0",
        "bcryptjs": "^3.0.2",
        "cheerio": "^1.2.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "lucide-react": "^0.525.0",
        "luxon": "^3.7.2",
        "pg": "^8.16.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-router-dom": "^7.9.6",
        "tough-cookie": "^6.0.2",
        "web-push": "^3.6.7",
        "zod": "^4.1.11"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@tailwindcss/vite": "^4.1.12",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/luxon": "^3.7.6",
        "@types/node": "^24.5.1",
        "@types/pg": "^8.15.5",
        "@types/react": "^19.1.16",
        "@types/react-dom": "^19.1.9",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-react": "^5.0.2",
        "concurrently": "^9.2.1",
        "postcss": "^8.5.6",
        "puppeteer": "^25.12.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2",
        "vite": "^7.1.3",
        "vite-plugin-pwa": "^2.0.0"
    }
}
