# Local development: copy to .env.development and set DOTENV_CONFIG_PATH.
NODE_ENV=development
APP_URL=http://localhost:5173
PORT=4000
WORKER_PORT=4001
WORKER_URL=http://127.0.0.1:4001
LMS_BASE_URL=https://lms.itmnganjuk.ac.id
LMS_TIMEZONE=Asia/Jakarta

# Development Neon branch: pooled runtime and direct migrations.
DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full

# Generate once with npm run config:keys, then paste values here.
CREDENTIAL_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
